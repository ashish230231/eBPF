# ─── eBPF build artifacts ───────────────────────────────────────────────
# Compiled BPF objects (regenerated from *.bpf.c by clang)
*.bpf.o
*.o

# libbpf skeleton headers (generated by `bpftool gen skeleton`), added later
*.skel.h

# Compiled user-space loaders / binaries (no extension, produced by later lessons)
# Add specific names here as you build them, e.g.:
# 02-loader/loader
# eunomia-bpf output (if you ever use the ecc/ecli path)
package.json
*.bpf.package.json

# ─── Generated kernel type header ───────────────────────────────────────
# vmlinux.h is generated from your kernel's BTF and is large + kernel-specific.
# We ignore it and regenerate per machine. To (re)generate:
#   bpftool btf dump file /sys/kernel/btf/vmlinux format c > common/vmlinux.h
# If you'd rather commit it (so the repo builds without bpftool), delete the
# line below.
common/vmlinux.h

# ─── Editor / OS noise ──────────────────────────────────────────────────
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# ─── Misc ───────────────────────────────────────────────────────────────
*.log
